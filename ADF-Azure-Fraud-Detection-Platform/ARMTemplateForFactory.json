		{
			"name": "[concat(parameters('factoryName'), '/DF_Fraud_Detection')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Transactions",
								"type": "DatasetReference"
							},
							"name": "transaction"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_HighRiskTransactions",
								"type": "DatasetReference"
							},
							"name": "HighRiskTransactionsSink"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_ForeignTransactions",
								"type": "DatasetReference"
							},
							"name": "ForeignTransactionsSink"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Fraud_Alerts",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "HighValueFilter"
						},
						{
							"name": "ForeignTransactionFilter"
						},
						{
							"name": "CalculateFraudScore"
						},
						{
							"name": "FraudScore"
						}
					],
					"scriptLines": [
						"source(output(",
						"          transaction_id as string,",
						"          account_id as string,",
						"          amount as string,",
						"          country as string,",
						"          transaction_time as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> transaction",
						"transaction filter(toInteger(amount)>10000) ~> HighValueFilter",
						"transaction filter(country!='India') ~> ForeignTransactionFilter",
						"transaction derive(FraudScore = iif(toInteger(amount)>10000, 50, 0)\r",
						"+\r",
						"iif(country != 'India', 30, 0)) ~> CalculateFraudScore",
						"CalculateFraudScore filter(FraudScore >= 50) ~> FraudScore",
						"HighValueFilter sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> HighRiskTransactionsSink",
						"ForeignTransactionFilter sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> ForeignTransactionsSink",
						"FraudScore sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Transactions')]",
				"[concat(variables('factoryId'), '/datasets/DS_Gold_HighRiskTransactions')]",
